+static void glGpuSetTexRepeat(Renderer* renderer, bool enable) {
+    if (renderer->texRepeat == enable) return;
+    GLRenderer* gl = (GLRenderer*)renderer;
+    flushBatch(gl);
+    renderer->texRepeat = enable;
+    GLint previousTexture;
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &previousTexture);
+    GLint mode = enable ? GL_REPEAT : GL_CLAMP_TO_EDGE;
+    repeat(gl->textureCount, i) {
+        if (!gl->textureLoaded[i]) continue;
+        glBindTexture(GL_TEXTURE_2D, gl->glTextures[i]);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, mode);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, mode);
+    }
+    repeat(gl->surfaceCount, i) {
+        if (!gl->surfaceTexture[i]) continue;
+        glBindTexture(GL_TEXTURE_2D, gl->surfaceTexture[i]);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, mode);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, mode);
+    }
+    glBindTexture(GL_TEXTURE_2D, (GLuint)previousTexture);
+}
