+    #elif defined(__EMSCRIPTEN__)
+    // The renderer's own shaders already declare #version 300 es; only version-less game shaders are translated.
+    char* translatedSource = (gTranslateGles100 && strstr(source, "#version") == nullptr) ? translateGles100To300(source, type) : nullptr;
+    const char* actualSource = translatedSource != nullptr ? translatedSource : source;
     #else
     const char* actualSource = source;
     #endif
     GLuint shader = glCreateShader(type);
     glShaderSource(shader, 1, &actualSource, nullptr);
+    #if defined(__EMSCRIPTEN__) && !defined(PLATFORM_VITA)
+    free(translatedSource);
+    #endif
     glCompileShader(shader);
 
     GLint success;
