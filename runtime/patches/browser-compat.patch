+#ifndef UNDERRUNE_BROWSER_AUDIO_SPATIAL_H
+#define UNDERRUNE_BROWSER_AUDIO_SPATIAL_H
+// GameMaker distance-model values: see the pinned official HTML5 runner.
+static inline ma_attenuation_model browserFalloffModel(int32_t model) {
+    switch (model) {
+        case 3: case 4: return ma_attenuation_model_linear;
+        case 5: case 6: return ma_attenuation_model_exponential;
+        default: return ma_attenuation_model_inverse;
+    }
+}
+static inline void browserListenerOrientation(ma_engine* engine, float fx, float fy, float fz, float ux, float uy, float uz) {
+    ma_engine_listener_set_direction(engine, 0, fx, fy, fz);
+    ma_engine_listener_set_world_up(engine, 0, ux, uy, uz);
+}
+#endif
