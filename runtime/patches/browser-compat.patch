     }
 }
 
+// UnderRune parity trace: {"f":frame,"room":name,"rng":[index,s0..s15],"g":{name:value},"o":[[id,object,x,y,imageIndex,sprite,visible],...]}
+char* Runner_traceFrameJson(Runner* runner, const char* globalsCsv) {
+    DataWin* dataWin = runner->dataWin;
+    JsonWriter w = JsonWriter_create();
+    JsonWriter_beginObject(&w);
+    JsonWriter_propertyInt(&w, "f", runner->frameCount);
+    JsonWriter_propertyString(&w, "room", runner->currentRoom != nullptr ? runner->currentRoom->name : "");
+
+    JsonWriter_key(&w, "rng");
+    JsonWriter_beginArray(&w);
+    JsonWriter_int(&w, runner->random.index);
+    repeat(16, i) JsonWriter_int(&w, runner->random.state[i]);
+    JsonWriter_endArray(&w);
+
+    JsonWriter_key(&w, "g");
+    JsonWriter_beginObject(&w);
+    Instance* globals = runner->vmContext != nullptr ? (Instance*) runner->vmContext->globalScopeInstance : nullptr;
+    if (globalsCsv != nullptr && globals != nullptr) {
+        const char* cursor = globalsCsv;
+        while (*cursor != '\0') {
+            const char* end = cursor;
+            while (*end != '\0' && *end != ',') end++;
+            size_t length = (size_t) (end - cursor);
+            repeat(dataWin->vari.variableCount, varIdx) {
+                Variable* var = &dataWin->vari.variables[varIdx];
+                if (var->instanceType != INSTANCE_GLOBAL || strlen(var->name) != length || strncmp(var->name, cursor, length) != 0) continue;
+                RValue* slot = IntRValueHashMap_findSlot(&globals->selfVars, var->varID);
+                JsonWriter_key(&w, var->name);
+                if (slot != nullptr) writeRValueJson(&w, *slot); else JsonWriter_null(&w);
+                break;
+            }
+            cursor = *end == ',' ? end + 1 : end;
+        }
+    }
+    JsonWriter_endObject(&w);
+
+    JsonWriter_key(&w, "o");
+    JsonWriter_beginArray(&w);
+    repeat((int32_t) arrlen(runner->instances), i) {
+        Instance* inst = runner->instances[i];
+        if (!inst->active) continue;
+        const char* objName = (inst->objectIndex >= 0 && dataWin->objt.count > (uint32_t) inst->objectIndex) ? dataWin->objt.objects[inst->objectIndex].name : "";
+        const char* spriteName = (inst->spriteIndex >= 0 && dataWin->sprt.count > (uint32_t) inst->spriteIndex) ? dataWin->sprt.sprites[inst->spriteIndex].name : "";
+        JsonWriter_beginArray(&w);
+        JsonWriter_int(&w, inst->instanceId);
+        JsonWriter_string(&w, objName);
+        JsonWriter_double(&w, inst->x);
+        JsonWriter_double(&w, inst->y);
+        JsonWriter_double(&w, inst->imageIndex);
+        JsonWriter_string(&w, spriteName);
+        JsonWriter_bool(&w, inst->visible);
+        JsonWriter_endArray(&w);
+    }
+    JsonWriter_endArray(&w);
+    JsonWriter_endObject(&w);
+    char* out = JsonWriter_copyOutput(&w);
+    JsonWriter_free(&w);
+    return out;
+}
