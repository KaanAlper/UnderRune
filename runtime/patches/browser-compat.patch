+#ifdef __EMSCRIPTEN__
+// WebGL2 still applies the GLSL ES 1.00 Appendix A loop limits to version-less (1.00) shaders, so
+// GameMaker shaders with non-constant loop bounds (palette swappers, blurs) fail to compile.
+// On a WebGL2 context they are compiled as GLSL ES 3.00 with the equivalent keywords instead.
+static bool gTranslateGles100 = false;
+
+static bool isShaderIdentChar(char c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
+}
+
+static const char* gles300Word(const char* word, bool fragment) {
+    if (strcmp(word, "attribute") == 0) return fragment ? word : "in";
+    if (strcmp(word, "varying") == 0) return fragment ? "in" : "out";
+    if (strcmp(word, "gl_FragColor") == 0) return fragment ? "ur_FragColor" : word;
+    if (strcmp(word, "texture2D") == 0 || strcmp(word, "textureCube") == 0) return "texture";
+    if (strcmp(word, "texture2DLod") == 0 || strcmp(word, "textureCubeLod") == 0) return "textureLod";
+    if (strcmp(word, "texture2DProj") == 0) return "textureProj";
+    // Names that became built-ins or keywords in 3.00 must not shadow them.
+    if (strcmp(word, "texture") == 0) return "ur_texture";
+    if (strcmp(word, "sample") == 0) return "ur_sample";
+    return word;
+}
+
+static char* translateGles100To300(const char* source, GLenum type) {
+    bool fragment = type == GL_FRAGMENT_SHADER;
+    size_t length = strlen(source);
+    size_t capacity = length * 2 + 128;
+    size_t used = 0;
+    char* out = (char*) safeMalloc(capacity);
+    #define UR_APPEND(text, count) do { \
+        size_t count_ = (count); \
+        if (used + count_ + 1 > capacity) { capacity = (used + count_ + 1) * 2; out = (char*) safeRealloc(out, capacity); } \
+        memcpy(out + used, (text), count_); used += count_; \
+    } while (0)
+    const char* header = fragment ? "#version 300 es\nprecision mediump float;\nout vec4 ur_FragColor;\n" : "#version 300 es\n";
+    UR_APPEND(header, strlen(header));
+    size_t i = 0;
+    while (i < length) {
+        char c = source[i];
+        bool startsWord = ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_') && (i == 0 || !isShaderIdentChar(source[i - 1]));
+        if (!startsWord) { UR_APPEND(&source[i], 1); i++; continue; }
+        size_t start = i;
+        while (i < length && isShaderIdentChar(source[i])) i++;
+        char word[64];
+        size_t wordLength = i - start;
+        if (wordLength >= sizeof(word)) { UR_APPEND(&source[start], wordLength); continue; }
+        memcpy(word, &source[start], wordLength);
+        word[wordLength] = '\0';
+        const char* replacement = gles300Word(word, fragment);
+        UR_APPEND(replacement, strlen(replacement));
+    }
+    out[used] = '\0';
+    #undef UR_APPEND
+    return out;
+}
+#endif
