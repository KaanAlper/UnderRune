{
 "name": "shadowcrystal-local",
 "version": "0.1.0",
 "private": true,
 "type": "module",
 "scripts": {
  "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
  "build": "tsc --noEmit && vite build",
  "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
  "test:tools": "node --test tests/*.test.mjs",
  "test": "vitest run",
  "typecheck": "tsc --noEmit",
  "extract": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/extract.ps1",
  "inventory": "node tools/catalog.mjs",
  "coverage:bosses": "node tools/check-coverage.mjs"
 },
 "devDependencies": {
  "@playwright/test": "1.63.0",
  "@types/node": "26.6.4",
  "typescript": "7.0.2",
  "vite": "8.3.2",
  "vitest": "5.0.3"
 }
}
